# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# Required for the agent (src/agent/agent.py) - get a free-tier key at
# https://console.groq.com
GROQ_API_KEY=

# Local Postgres (defaults already match the docker run command in
# README.md - only needed if you're running Postgres somewhere else).
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ml_insight
PG_USER=postgres
PG_PASSWORD=devpassword

# Optional: overrides all PG_* vars above with a single connection string
# (any valid libpq URI). This is how a deployment points at a different
# Postgres - e.g. Supabase - without any code change: set this instead of
# the PG_* vars. See src/common/db.py.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required only by scripts/migrate_to_supabase.py - the Supabase project's
# connection string (Project Settings -> Database -> Connection string).
# If the password contains special characters, percent-encode them
# (e.g. @ -> %40, + -> %2B, $ -> %24).
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Redis connection (src/common/redis_client.py). Defaults to local Redis
# (matching the docker run command in README.md) if not set - only needed
# if you're pointing at something else, e.g. hosted Redis. rediss:// (note
# the double s) enables TLS, auto-detected by redis-py from the scheme -
# required by most hosted Redis providers, including Upstash.
# REDIS_URL=redis://localhost:6379

# Upstash (https://upstash.com) connection string - set REDIS_URL to this
# value to point feature_cache.py/semantic_cache.py at Upstash instead of
# local Redis.
# UPSTASH_REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Required by src/serving/auth.py - signs and verifies JWTs for
# /auth/signup, /auth/login, and every request to the protected /predict
# and /chat endpoints. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: this is a symmetric signing key - anyone who has it can mint
# a valid token for any user id. Rotate it (generate a new one) before any
# real/production use, and never commit a real value - this file only
# documents the variable, actual values belong in .env (gitignored).
JWT_SECRET_KEY=


