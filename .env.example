ml-insight-platform/
│
├── .env.example                  # template for secrets/config (never commit real .env)
├── .gitignore
├── README.md
├── requirements.txt               # or pyproject.toml if using poetry/uv
├── docker-compose.yml             # postgres, redis, rabbitmq services (add as you build)
│
├── data/
│   ├── raw/                       # original Kaggle dataset, untouched
│   ├── synthetic/                 # generated event data lands here
│   └── processed/                 # feature-engineered outputs
│
├── notebooks/
│   └── 01_eda.ipynb               # exploration only — nothing production lives here
│
├── src/
│   ├── __init__.py
│   ├── ingestion/                 # event producers/consumers (Week 1-2)
│   │   └── __init__.py
│   ├── data_gen/                  # synthetic data generator (Week 1)
│   │   └── __init__.py
│   ├── pipelines/                 # feature engineering, Prefect flows (Week 2)
│   │   └── __init__.py
│   ├── models/                    # training scripts, MLflow logging (Week 3)
│   │   └── __init__.py
│   ├── serving/                   # FastAPI app (Week 4)
│   │   └── __init__.py
│   ├── agent/                     # LangChain agent, tools, RAG (Week 5-6)
│   │   └── __init__.py
│   └── common/                    # shared config, logging, db connections
│       └── __init__.py
│
├── configs/
│   └── config.yaml                # paths, hyperparams, service URLs
│
├── tests/
│   ├── unit/
│   └── integration/
│
├── docker/
│   └── (Dockerfiles per service, added as needed)
│
├── docs/
│   ├── PRD.md                     # product doc (Week 8)
│   └── decisions.md               # trade-off log — start this NOW, not later
│
└── NOTES.md                       # your running daily log