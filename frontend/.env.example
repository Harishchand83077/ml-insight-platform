# Copy this file to .env.local and fill in real values. .env.local is
# gitignored (frontend/.gitignore's *.local rule) - never commit it.

# The backend API's base URL. Defaults to http://localhost:8000 in
# src/api.js if unset, so this is only needed to point at something else
# (e.g. the deployed Render backend).
VITE_API_BASE_URL=http://localhost:8000
